# ot serve configuration, read by ot.service. Every `ot serve -h` flag can be
# set here as OT_<FLAG> (upper case, dashes as underscores).

# Names ot answers to. The first is shown in the UI. Requests with any other
# Host header are refused (DNS-rebinding defence).
OT_HOSTS=@OT_HOSTS@

# Peers allowed to connect: the tailnet, plus localhost for on-Pi health checks.
OT_ALLOW_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48,127.0.0.1/32,::1/128

OT_LISTEN=:80
OT_DB=/var/lib/ot/ot.db
OT_SNAPSHOT_DIR=/var/lib/ot/snapshots
OT_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
OT_LOG_LEVEL=info
