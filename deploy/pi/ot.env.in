# ot serve configuration, read by ot.service. MANAGED by deploy/pi/bootstrap.sh
# and rewritten on every run: put your own settings in /etc/ot/ot.local.env.
# Every `ot serve -h` flag can be set as OT_<FLAG> (upper case, dashes as
# underscores).

# Names ot answers to. The first is shown in the UI. Requests with any other
# Host header are refused (DNS-rebinding defence).
OT_HOSTS=@OT_HOSTS@

# Peers allowed to connect: the tailnet, localhost (on-Pi health checks), and
# the LAN subnet when bootstrap.sh ran with --lan-access.
OT_ALLOW_CIDRS=@OT_ALLOW_CIDRS@

OT_LISTEN=:80
OT_DB=/var/lib/ot/ot.db
OT_SNAPSHOT_DIR=/var/lib/ot/snapshots
OT_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
OT_LOG_LEVEL=info
