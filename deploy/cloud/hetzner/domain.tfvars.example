# Your own domain, no Tailscale (docs/cloud.md, the walkthrough):
#   cp domain.tfvars.example terraform.tfvars    (gitignored), then edit.
# Opens TCP 80 and 443 to everyone and SSH to ssh_cidrs only. Pass the API
# token as TF_VAR_hcloud_token, never in this file.
name           = "me"
location       = "hel1" # cheapest; ash or hil for US latency (€17.99)
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

public_domain = "me.example.com"
ipv4          = true               # billed separately by Hetzner; needed for a public domain
ssh_cidrs     = ["203.0.113.7/32"] # your home IPv4: curl -s https://checkip.amazonaws.com

# Add tailscale = true (and TF_VAR_tailscale_auth_key) to put the server on
# your tailnet as well.
