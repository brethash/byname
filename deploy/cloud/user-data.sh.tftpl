#!/bin/sh
# byname first boot, rendered by OpenTofu from deploy/cloud/user-data.sh.tftpl.
# POSIX sh on purpose (Lightsail may wrap launch scripts in its own sh
# script); it writes deploy/cloud/first-boot.sh out and runs it with bash.
set -eu
umask 077
cat > /run/byname-first-boot.sh <<'BYNAME_FIRST_BOOT_EOF'
${script}
BYNAME_FIRST_BOOT_EOF
BYNAME_NAME='${name}' BYNAME_TAG='${tag}' BYNAME_ADMIN_USER='${admin_user}' BYNAME_SSH_KEY='${ssh_key}' BYNAME_TS_AUTHKEY='${auth_key}' \
  bash /run/byname-first-boot.sh
rm -f /run/byname-first-boot.sh
