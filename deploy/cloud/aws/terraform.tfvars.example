# Copy to terraform.tfvars (gitignored).
name           = "nym"
region         = "us-west-2"
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Without Tailscale: your own domain, IPv4, and SSH from your address only.
public_domain = "nym.example.com"
ipv4          = true                 # $5.00/month instead of $3.50; needed for a public domain
ssh_cidrs     = ["203.0.113.7/32"]   # curl -s https://checkip.amazonaws.com

# With Tailscale instead (or as well): pass the auth key as
# TF_VAR_tailscale_auth_key, never in this file.
# tailscale = true
