{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutOtBackupsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/ot/*",
      "Condition": {
        "StringEquals": { "s3:x-amz-server-side-encryption": "AES256" }
      }
    }
  ]
}
