# ot serve configuration, read by ot.service. MANAGED by deploy/host/bootstrap.sh
# and rewritten on every run: put your own settings in /etc/ot/ot.local.env.
# Every `ot serve -h` flag can be set as OT_<FLAG> (upper case, dashes as
# underscores).

# Names ot answers to. The first is the service name shown in the UI
# (bootstrap.sh --name). Requests with any other Host header are refused
# (DNS-rebinding defence).
OT_HOSTS=@OT_HOSTS@

# Peers allowed to connect: the tailnet, localhost (on-host health checks),
# and the LAN subnet when bootstrap.sh ran with --lan-access (Pi only).
OT_ALLOW_CIDRS=@OT_ALLOW_CIDRS@

OT_LISTEN=:80
OT_DB=/var/lib/ot/ot.db
OT_SNAPSHOT_DIR=/var/lib/ot/snapshots
OT_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
OT_LOG_LEVEL=info

# Public address through Tailscale Funnel (bootstrap.sh --public), or empty for
# tailnet-only. With it set, ot also listens on OT_PUBLIC_LISTEN and needs a
# sign-in provider in ot.local.env: OT_GOOGLE_CLIENT_ID + OT_GOOGLE_ALLOW
# and/or OT_SLACK_CLIENT_ID + OT_SLACK_TEAMS, secrets in /etc/credstore
# (docs/public-access.md).
OT_PUBLIC_URL=@OT_PUBLIC_URL@
OT_PUBLIC_LISTEN=unix:/run/ot/public.sock
