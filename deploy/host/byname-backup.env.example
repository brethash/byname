# Copy to /etc/byname/byname-backup.env to enable S3 backups (then:
#   sudo systemctl enable --now byname-backup.timer).
# The AWS key goes in /etc/credstore/byname-backup-aws (root, 0600), in AWS
# shared-credentials format:
#   [default]
#   aws_access_key_id = AKIA...
#   aws_secret_access_key = ...
BYNAME_BUCKET=your-bucket-name
BYNAME_REGION=us-west-2
BYNAME_PREFIX=byname/
