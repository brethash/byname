# Copy to /etc/ot/ot-backup.env to enable S3 backups (then:
#   sudo systemctl enable --now ot-backup.timer).
# The AWS key goes in /etc/credstore/ot-backup-aws (root, 0600), in AWS
# shared-credentials format:
#   [default]
#   aws_access_key_id = AKIA...
#   aws_secret_access_key = ...
OT_BUCKET=your-bucket-name
OT_REGION=us-west-2
OT_PREFIX=ot/
