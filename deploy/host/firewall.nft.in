#!/usr/sbin/nft -f
# byname firewall — rendered by bootstrap.sh into /etc/byname/firewall.nft.
# Input policy DROP; reachable: what bootstrap.sh's flags turn on (byname on the
# tailnet, the LAN, or its public domain; OpenSSH from the LAN, the tailnet or
# --ssh-from addresses).
# Output is not filtered.
#
# The first two lines make reloading idempotent: create the table if missing,
# then delete and recreate it. Nothing outside table inet byname_filter is touched.
table inet byname_filter
delete table inet byname_filter

table inet byname_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # With Tailscale, byname trusts tailnet addresses, which only ever arrive
    # on tailscale0: drop them on any other interface, whatever tailscaled's
    # own rules do (LAN access and --public-domain open port 80 beyond it).
    @TAILNET_SPOOF_RULES@

    # ICMP/ICMPv6 (path MTU discovery, IPv6 neighbour discovery).
    meta l4proto { icmp, ipv6-icmp } accept

    # DHCP and DHCPv6 replies to this host.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # With Tailscale: its direct (peer-to-peer WireGuard) path, which never
    # answers a packet that isn't from a known peer, and byname on the tailnet.
    @TAILNET_RULES@

    # byname on the home LAN (Pi with --lan-access).
    @LAN_HTTP_RULE@

    # byname's public domain (--public-domain): HTTPS, and HTTP for redirects and
    # Let's Encrypt's checks.
    @PUBLIC_RULE@

    # OpenSSH, key-only: from the home LAN (Pi), over the tailnet (cloud with
    # Tailscale, where Tailscale SSH normally answers first), and from
    # --ssh-from addresses.
    @SSH_RULE@
  }
}
