#!/usr/sbin/nft -f
# ot firewall — rendered by bootstrap.sh into /etc/ot/firewall.nft.
# Input policy DROP; reachable: ot on tailscale0 (and, on a Pi, from the LAN
# subnet when bootstrap.sh ran with --lan-access) and break-glass OpenSSH
# (from the LAN on a Pi, over the tailnet on a cloud server).
# Output is not filtered.
#
# The first two lines make reloading idempotent: create the table if missing,
# then delete and recreate it. Nothing outside table inet ot_filter is touched.
table inet ot_filter
delete table inet ot_filter

table inet ot_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # ICMP/ICMPv6 (path MTU discovery, IPv6 neighbour discovery).
    meta l4proto { icmp, ipv6-icmp } accept

    # DHCP and DHCPv6 replies to this host.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # Tailscale direct (peer-to-peer WireGuard) path; without it traffic
    # still flows via DERP relays, just slower. WireGuard never answers a
    # packet that isn't from a known peer, so this port looks closed.
    udp dport 41641 accept

    # ot on the tailnet, and optionally (Pi only) on the home LAN.
    iifname "tailscale0" tcp dport 80 accept
    @LAN_HTTP_RULE@

    # Break-glass OpenSSH, key-only: from the home LAN (Pi) or the tailnet
    # (cloud; normally Tailscale SSH answers there first).
    @SSH_RULE@
  }
}
