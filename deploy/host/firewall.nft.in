#!/usr/sbin/nft -f
# ot firewall — rendered by bootstrap.sh into /etc/ot/firewall.nft.
# Input policy DROP; reachable: what bootstrap.sh's flags turn on (ot on the
# tailnet, the LAN, or its public domain; OpenSSH from the LAN, the tailnet or
# --ssh-from addresses).
# Output is not filtered.
#
# The first two lines make reloading idempotent: create the table if missing,
# then delete and recreate it. Nothing outside table inet ot_filter is touched.
table inet ot_filter
delete table inet ot_filter

table inet ot_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # ICMP/ICMPv6 (path MTU discovery, IPv6 neighbour discovery).
    meta l4proto { icmp, ipv6-icmp } accept

    # DHCP and DHCPv6 replies to this host.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # With Tailscale: its direct (peer-to-peer WireGuard) path, which never
    # answers a packet that isn't from a known peer, and ot on the tailnet.
    @TAILNET_RULES@

    # ot on the home LAN (Pi with --lan-access).
    @LAN_HTTP_RULE@

    # ot's public domain (--public-domain): HTTPS, and HTTP for redirects and
    # Let's Encrypt's checks.
    @PUBLIC_RULE@

    # OpenSSH, key-only: from the home LAN (Pi), over the tailnet (cloud with
    # Tailscale, where Tailscale SSH normally answers first), and from
    # --ssh-from addresses.
    @SSH_RULE@
  }
}
