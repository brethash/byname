# byname serve configuration, read by byname.service. MANAGED by deploy/host/bootstrap.sh
# and rewritten on every run: put your own settings in /etc/byname/byname.local.env.
# Every `byname serve -h` flag can be set as BYNAME_<FLAG> (upper case, dashes as
# underscores).

# Names byname answers to. The first is the service name shown in the UI
# (bootstrap.sh --name). Requests with any other Host header are refused
# (DNS-rebinding defence).
BYNAME_HOSTS=@BYNAME_HOSTS@

# Peers allowed to connect: the tailnet, localhost (on-host health checks),
# and the LAN subnet when bootstrap.sh ran with --lan-access (Pi only).
BYNAME_ALLOW_CIDRS=@BYNAME_ALLOW_CIDRS@

# Without Tailscale (bootstrap.sh --no-tailscale) there is nobody to ask.
BYNAME_NO_WHOIS=@BYNAME_NO_WHOIS@

BYNAME_LISTEN=:80
BYNAME_DB=/var/lib/byname/byname.db
BYNAME_SNAPSHOT_DIR=/var/lib/byname/snapshots
BYNAME_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
BYNAME_LOG_LEVEL=info

# Public address: your own domain served directly (bootstrap.sh --public-domain,
# listening on :443) or the tailnet name through Tailscale Funnel (--funnel,
# on a unix socket). Empty: none. With it set, byname needs a sign-in provider in
# byname.local.env: BYNAME_GOOGLE_CLIENT_ID + BYNAME_GOOGLE_ALLOW and/or BYNAME_SLACK_CLIENT_ID
# + BYNAME_SLACK_TEAMS, secrets in /etc/credstore (docs/public-access.md).
BYNAME_PUBLIC_URL=@BYNAME_PUBLIC_URL@
BYNAME_PUBLIC_LISTEN=@BYNAME_PUBLIC_LISTEN@
