// Tailscale policy additions for byname. Merge these into your tailnet policy
// file (admin console → Access controls). Replace:
//   tag:me             tag:<name> if you chose another service name
//                      (bootstrap.sh --name, or `name` in deploy/cloud)
//   <you@example.com>  your Tailscale login
//   <admin>            the host's admin user: your own user on a Pi,
//                      "admin" on a cloud server
//
// NOTE: these grants only restrict anything once the default allow-all rule
// is removed from your policy, which affects your whole tailnet. Keeping
// allow-all is acceptable: byname enforces its own tailnet-only checks.
{
  "tagOwners": {
    "tag:me": ["<you@example.com>"],
  },

  "grants": [
    // Household members (not tagged servers, not shared-in users) may use byname:
    // http://me/ on port 80, and https://me.<tailnet>.ts.net on 443 when
    // --funnel is on.
    {"src": ["autogroup:member"], "dst": ["tag:me"], "ip": ["tcp:80", "tcp:443"]},

    // SSH to the host for you only. Tailscale SSH needs this network rule as
    // well as the "ssh" rule below: without it, removing allow-all breaks
    // `ssh <admin>@me` and `make deploy`.
    {"src": ["<you@example.com>"], "dst": ["tag:me"], "ip": ["tcp:22"]},
  ],

  // Only for bootstrap.sh --funnel: uncomment to let the host publish its
  // https:// name on the internet with Tailscale Funnel, and turn on HTTPS
  // certificates (admin console → DNS). Leave it commented out for a
  // tailnet-only byname, or one with its own domain (--public-domain).
  // "nodeAttrs": [
  //   {"target": ["tag:me"], "attr": ["funnel"]},
  // ],

  "ssh": [
    // Tailscale SSH to the host for you only, with periodic browser re-check.
    // While Tailscale SSH is on (tailscale up --ssh), tailscaled answers port
    // 22 on the tailnet itself, so OpenSSH is not reachable over the tailnet;
    // `sudo tailscale set --ssh=false` hands the port back to OpenSSH.
    {
      "action": "check",
      "src":    ["<you@example.com>"],
      "dst":    ["tag:me"],
      "users":  ["<admin>"],
    },
  ],
}
