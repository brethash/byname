// Tailscale policy additions for byname. Merge these into your tailnet policy
// file (admin console → Access controls). Replace:
//   tag:nym             tag:<name> if you chose another service name
//                      (bootstrap.sh --name, or `name` in deploy/cloud)
//   <you@example.com>  your Tailscale login
//   <admin>            the host's admin user: your own user on a Pi,
//                      "admin" on a cloud server
//
// NOTE: these grants only restrict anything once the default allow-all rule
// is removed from your policy, which affects your whole tailnet. Keeping
// allow-all is acceptable: byname enforces its own tailnet-only checks.
{
  "tagOwners": {
    "tag:nym": ["<you@example.com>"],
  },

  "grants": [
    // Household members (not tagged servers, not shared-in users) may use byname:
    // http://nym/ on port 80, and https://nym.<tailnet>.ts.net on 443 when
    // the public address is on.
    {"src": ["autogroup:member"], "dst": ["tag:nym"], "ip": ["tcp:80", "tcp:443"]},
  ],

  // Only for bootstrap.sh --public: uncomment to let the host publish its
  // https:// name on the internet with Tailscale Funnel, and turn on HTTPS
  // certificates (admin console → DNS). Leave it commented out for a
  // tailnet-only byname.
  // "nodeAttrs": [
  //   {"target": ["tag:nym"], "attr": ["funnel"]},
  // ],

  "ssh": [
    // Tailscale SSH to the host for you only, with periodic browser re-check.
    {
      "action": "check",
      "src":    ["<you@example.com>"],
      "dst":    ["tag:nym"],
      "users":  ["<admin>"],
    },
  ],
}
