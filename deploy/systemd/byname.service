# byname short-link service. Installed by deploy/host/bootstrap.sh; configured by
# /etc/byname/byname.env (managed) and /etc/byname/byname.local.env (yours), BYNAME_* variables,
# see `byname serve -h`. Drop-ins in byname.service.d, written by bootstrap.sh:
# 05-tailscale.conf (with Tailscale) starts it after tailscaled, and
# 10-lan-access.conf (--lan-access) adds the LAN subnet to IPAddressAllow.
[Unit]
Description=byname short links
# Not tailscaled.service: Wants= starts even a disabled unit, which would bring
# tailscaled (and Tailscale SSH, past the firewall) back on a --no-tailscale
# host. 05-tailscale.conf adds it when Tailscale is in use.
After=network-online.target byname-firewall.service
Wants=network-online.target byname-firewall.service
ConditionPathExists=/usr/local/lib/byname/current/byname

[Service]
Type=simple
User=byname
Group=byname
EnvironmentFile=/etc/byname/byname.env
EnvironmentFile=-/etc/byname/byname.local.env
Environment=GOMEMLIMIT=96MiB
ExecStart=/usr/local/lib/byname/current/byname serve
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

# State: /var/lib/byname (database) and /var/lib/byname/snapshots, group-readable so
# the byname-backup user (in group byname) can upload snapshots.
StateDirectory=byname byname/snapshots
StateDirectoryMode=0750
UMask=0027

# Bind :80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: everything read-only except StateDirectory. The tailscaled
# socket under /run stays usable: connecting to a unix socket on a read-only
# mount is allowed.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and process surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network: only tailnet peers and localhost (health checks) may talk to the
# service, plus the LAN subnet if the 10-lan-access.conf drop-in exists. It
# makes no outbound connections, except with the public address on: the
# 20-public.conf drop-in (bootstrap.sh --public) allows any address so
# sign-in can reach Google and Slack, and adds /run/byname for the socket that
# Tailscale Funnel proxies to. AF_UNIX is for tailscaled.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48

# Resources (a Pi 3B has 1 GB; the smallest cloud servers 512 MB).
MemoryMax=192M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
