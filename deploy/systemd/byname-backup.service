# Uploads the newest byname snapshot to S3. Runs as its own user, the only
# process that ever sees the AWS key (delivered via LoadCredential=).
# Configured by /etc/byname/byname-backup.env: BYNAME_BUCKET, BYNAME_REGION, BYNAME_PREFIX.
[Unit]
Description=byname backup (upload newest snapshot to S3)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/byname/byname-backup.env
ConditionPathExists=/etc/credstore/byname-backup-aws

[Service]
Type=oneshot
User=byname-backup
Group=byname-backup
SupplementaryGroups=byname
EnvironmentFile=/etc/byname/byname-backup.env
LoadCredential=aws:/etc/credstore/byname-backup-aws
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws
Environment=AWS_EC2_METADATA_DISABLED=true
# Dual-stack S3 endpoints, so IPv6-only cloud servers can reach S3 too.
Environment=AWS_USE_DUALSTACK_ENDPOINT=true
ExecStart=/usr/local/lib/byname/current/byname backup --snapshot-dir /var/lib/byname/snapshots --state-file /var/lib/byname-backup/last-upload
StateDirectory=byname-backup
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
