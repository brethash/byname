# ot short-link service. Installed by deploy/pi/bootstrap.sh; configured by
# /etc/ot/ot.env (OT_* variables, see `ot serve -h`).
[Unit]
Description=ot short links
After=network-online.target tailscaled.service ot-firewall.service
Wants=network-online.target tailscaled.service ot-firewall.service
ConditionPathExists=/usr/local/lib/ot/current/ot

[Service]
Type=simple
User=ot
Group=ot
EnvironmentFile=/etc/ot/ot.env
Environment=GOMEMLIMIT=96MiB
ExecStart=/usr/local/lib/ot/current/ot serve
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

# State: /var/lib/ot (database) and /var/lib/ot/snapshots, group-readable so
# the ot-backup user (in group ot) can upload snapshots.
StateDirectory=ot ot/snapshots
StateDirectoryMode=0750
UMask=0027

# Bind :80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: everything read-only except StateDirectory. The tailscaled
# socket under /run stays usable: connecting to a unix socket on a read-only
# mount is allowed.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and process surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Network: only tailnet peers (and localhost for health checks) may talk to
# the service; it makes no outbound connections. AF_UNIX is for tailscaled.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost 100.64.0.0/10 fd7a:115c:a1e0::/48

# Resources (Pi 3B has 1 GB).
MemoryMax=192M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
