# worktrees — per-machine app state (moved between machines by `worktrees sync`, not git)
/.worktrees.places.json
/.worktrees/

# planning docs — local working memory
/task_plan.md
/findings.md
/progress.md

# build output
/bin/
/dist/
/tmp/

# OpenTofu (deploy/cloud): state, plans and tfvars hold secrets; lock files are committed
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
*.tfplan
crash.log

# databases the docs copy to your machine (moving hosts, restores from S3)
*.db
*.db.gz
